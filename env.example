# Railway provides this automatically when you add a Postgres database
# (reference it as ${{Postgres.DATABASE_URL}} in the service variables).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional but recommended: require this access code for all API calls.
# Open the app once at  https://your-app.up.railway.app/#token=YOUR_CODE  on each device.
# APP_TOKEN=choose-a-long-random-string

# Optional: set to "require" only if you get an SSL error (e.g. connecting over the public proxy).
# PGSSLMODE=
